# User data: real instruments and the real ledger. Never committed.
# Seed data under data_store/seed/ IS committed -- it is the demo and test
# fixture, and it is synthetic.
portfolio/data_store/user/
data_store/user/

# What a schema migration copies the old file to before rewriting it. Kept on
# disk so nothing is lost, never committed: it is the previous state of
# whichever book was loaded.
*.before-trading-columns

# Spike output: raw provider responses, may contain account-shaped metadata
# and is regenerated on every run.
spike/results/

__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.DS_Store

# Build metadata and the price cache are regenerated, never committed.
*.egg-info/
portfolio/data_store/cache/
data_store/cache/
build/
